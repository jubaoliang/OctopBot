{
  "expo": {
    "name": "Octop",
    "slug": "OctopBot",
    "version": "1.0.0-alpha.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "octopbot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "dev.octop.octopbot"
    },
    "android": {
      "package": "dev.octop.octopbot",
      "adaptiveIcon": {
        "backgroundColor": "#FF0004",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO", "CAMERA"],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "ios": {
            "image": "./assets/images/splash-full.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "cover",
            "backgroundColor": "#FAFAFA",
            "dark": {
              "backgroundColor": "#111111",
              "image": "./assets/images/splash-full-dark.png"
            }
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 240,
            "backgroundColor": "#FAFAFA",
            "dark": {
              "backgroundColor": "#111111",
              "image": "./assets/images/splash-icon-dark.png"
            }
          },
          "dark": {
            "backgroundColor": "#111111",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Octop to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Octop to transcribe speech into text.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Octop to use the microphone for voice input."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Octop to access your photos so you can attach images to messages.",
          "cameraPermission": "Allow Octop to use the camera so you can attach a photo to a message."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
